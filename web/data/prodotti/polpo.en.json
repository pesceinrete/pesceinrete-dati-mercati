:1138.0,"quota":37.0,"prezzo":10.89,"variazione":0.3,"settimane_con_dati":4,"totale":false},{"codice":"SN","paese":"Senegal","tonnellate":565.0,"quota":18.0,"prezzo":9.54,"variazione":3.0,"settimane_con_dati":3,"totale":false},{"codice":"MR","paese":"Mauritania","tonnellate":455.0,"quota":15.0,"prezzo":10.29,"variazione":2.4,"settimane_con_dati":4,"totale":false},{"codice":"WORLD","paese":"all origins","tonnellate":3097.0,"quota":100.0,"prezzo":9.46,"variazione":0.9,"settimane_con_dati":4,"totale":true}]},"revisioni_recenti":[],"bollettino":[],"annotazioni":[],"rese":[{"etichetta":"Frozen whole, net of glaze","resa":100},{"etichetta":"Cooked","resa":58}],"dimostrativo":false,"lede":"Octopus imported into Italy from Morocco closes week 46 at €11.51/kg, up 3.7% on the week and 2.8% on the month. Against the same period of 2025 the price is 1.7% higher. For mid-November it is a normal level. Over the last twelve months available, September 2025 to August 2026, Italy imported 49,172 tonnes, 24% of it from Morocco, up 4% on the previous twelve.","sintesi_html":"<section class=\"pir-riquadro pir-sintesi\" id=\"sintesi\">\n  <h2>Octopus <b>at a glance</b></h2>\n  <p class=\"pir-lede\">Octopus imported into Italy from Morocco closes week 46 at €11.51/kg, up 3.7% on the week and 2.8% on the month. Against the same period of 2025 the price is 1.7% higher. For mid-November it is a normal level. Over the last twelve months available, September 2025 to August 2026, Italy imported 49,172 tonnes, 24% of it from Morocco, up 4% on the previous twelve.</p>\n  <table class=\"pir-tabella\">\n    <caption>Last twelve weeks. EUMOFA (European Commission), weekly EU imports from customs data.</caption>\n    <thead><tr><th>Week</th><th>€/kg</th><th>Tonnes</th></tr></thead>\n    <tbody><tr><td>2026-W35</td><td>10.48</td><td>405</td></tr><tr><td>2026-W36</td><td>11.10</td><td>161</td></tr><tr><td>2026-W37</td><td>10.18</td><td>174</td></tr><tr><td>2026-W38</td><td>10.75</td><td>254</td></tr><tr><td>2026-W39</td><td>10.67</td><td>341</td></tr><tr><td>2026-W40</td><td>10.63</td><td>180</td></tr><tr><td>2026-W41</td><td>10.85</td><td>291</td></tr><tr><td>2026-W42</td><td>11.19</td><td>329</td></tr><tr><td>2026-W43</td><td>10.65</td><td>472</td></tr><tr><td>2026-W44</td><td>10.41</td><td>181</td></tr><tr><td>2026-W45</td><td>11.10</td><td>246</td></tr><tr><td>2026-W46</td><td>11.51</td><td>239</td></tr></tbody>\n  </table>\n  <table class=\"pir-tabella pir-provenienze\"><caption>Non-EU origins compared, volume-weighted average of weeks 43-46. Change is against the previous four weeks.</caption><thead><tr><th>Origin</th><th>€/kg</th><th>Change</th><th>Tonnes</th><th>Share</th></tr></thead><tbody><tr><td>Morocco</td><td>10.89</td><td>+0.3%</td><td>1,138</td><td>37%</td></tr><tr><td>Senegal</td><td>9.54</td><td>+3.0%</td><td>565</td><td>18%</td></tr><tr><td>Mauritania</td><td>10.29</td><td>+2.4%</td><td>455</td><td>15%</td></tr><tr class=\"pir-totale\"><td>All origins</td><td>9.46</td><td>+0.9%</td><td>3,097</td><td>100%</td></tr></tbody></table>\n  <dl class=\"pir-domande\"><dt>Why Morocco as the headline?</dt><dd>It is the leading origin of octopus entering Italy and the only one with regular arrivals every week. Senegal and Mauritania ship less regularly: for them we show the average of the last four weeks.</dd><dt>Is this the price I pay my supplier?</dt><dd>No. It is the average value declared at customs by importers into Italy, across all sizes. Use it to compare your own purchase price with the average and to read the trend, not as a quotation.</dd><dt>How up to date is it?</dt><dd>The data come out every week and run to about two weeks earlier: the most recent week is always incomplete at the source and is published only once it is closed.</dd></dl>\n</section>"}