5.487},{"periodo":"2026-M05","tonnellate":250.248,"valore_unitario":18.115},{"periodo":"2026-M06","tonnellate":305.688,"valore_unitario":17.417},{"periodo":"2026-M07","tonnellate":307.437,"valore_unitario":19.751},{"periodo":"2026-M08","tonnellate":339.554,"valore_unitario":19.382}]},"provenienze_settimanali":{"dalla":"2026-W42","alla":"2026-W45","settimane":4,"voci":[{"codice":"WORLD","paese":"tutte le provenienze","tonnellate":141.0,"quota":100.0,"prezzo":18.11,"variazione":-5.1,"settimane_con_dati":4,"totale":true},{"codice":"US","paese":"Stati Uniti","tonnellate":130.0,"quota":93.0,"prezzo":17.95,"variazione":-5.1,"settimane_con_dati":4,"totale":false},{"codice":"CA","paese":"Canada","tonnellate":10.0,"quota":7.0,"prezzo":20.21,"variazione":2.3,"settimane_con_dati":3,"totale":false}]},"revisioni_recenti":[],"bollettino":[{"titolo":"Astice: cambia la posizione rispetto alla stagione","testo":"Quattro settimane fa il prezzo si collocava nella fascia centrale dei valori registrati in questo periodo dell'anno; ora si colloca nella fascia bassa (percentile 0 su 13 osservazioni degli anni 2023-2025). È il passaggio che conta per chi deve decidere se anticipare o rimandare un acquisto.","rilievo":"alto"}],"annotazioni":[],"rese":[{"etichetta":"Vivo, nessuna lavorazione","resa":100},{"etichetta":"Polpa cotta","resa":25}],"dimostrativo":false,"lede":"L'astice importato in Italia chiude la settimana 45 a 17,07 €/kg, in calo del 6,5% sulla settimana e del 10,6% sul mese. Sul 2025 il confronto resta in negativo: −12,0%. Per inizio novembre è il livello più basso degli ultimi tre anni. Negli ultimi dodici mesi l'Italia ne ha importato 2.897 tonnellate, per il 49% dagli Stati Uniti, in aumento del 4% sui dodici mesi precedenti.","sintesi_html":"<section class=\"pir-riquadro pir-sintesi\" id=\"sintesi\">\n  <h2>Astice <b>in sintesi</b></h2>\n  <p class=\"pir-lede\">L&#x27;astice importato in Italia chiude la settimana 45 a 17,07 €/kg, in calo del 6,5% sulla settimana e del 10,6% sul mese. Sul 2025 il confronto resta in negativo: −12,0%. Per inizio novembre è il livello più basso degli ultimi tre anni. Negli ultimi dodici mesi l&#x27;Italia ne ha importato 2.897 tonnellate, per il 49% dagli Stati Uniti, in aumento del 4% sui dodici mesi precedenti.</p>\n  <table class=\"pir-tabella\">\n    <caption>Ultime dodici settimane. EUMOFA (Commissione europea), importazioni UE settimanali da dati doganali.</caption>\n    <thead><tr><th>Settimana</th><th>€/kg</th><th>Tonnellate</th></tr></thead>\n    <tbody><tr><td>2026-W34</td><td>19,03</td><td>58</td></tr><tr><td>2026-W35</td><td>18,63</td><td>52</td></tr><tr><td>2026-W36</td><td>19,01</td><td>57</td></tr><tr><td>2026-W37</td><td>19,17</td><td>56</td></tr><tr><td>2026-W38</td><td>18,91</td><td>50</td></tr><tr><td>2026-W39</td><td>19,12</td><td>45</td></tr><tr><td>2026-W40</td><td>19,24</td><td>45</td></tr><tr><td>2026-W41</td><td>19,10</td><td>44</td></tr><tr><td>2026-W42</td><td>18,99</td><td>39</td></tr><tr><td>2026-W43</td><td>17,96</td><td>35</td></tr><tr><td>2026-W44</td><td>18,26</td><td>34</td></tr><tr><td>2026-W45</td><td>17,07</td><td>33</td></tr></tbody>\n  </table>\n  <table class=\"pir-tabella pir-provenienze\"><caption>Provenienze extra-UE a confronto, media delle settimane 42-45 pesata sui volumi. La variazione è sulle quattro settimane precedenti.</caption><thead><tr><th>Provenienza</th><th>€/kg</th><th>Variazione</th><th>Tonnellate</th><th>Quota</th></tr></thead><tbody><tr class=\"pir-totale\"><td>Tutte le provenienze</td><td>18,11</td><td>−5,1%</td><td>141</td><td>100%</td></tr><tr><td>Stati Uniti</td><td>17,95</td><td>−5,1%</td><td>130</td><td>93%</td></tr><tr><td>Canada</td><td>20,21</td><td>+2,3%</td><td>10</td><td>7%</td></tr></tbody></table>\n  <dl class=\"pir-domande\"><dt>È il prezzo che pago al fornitore?</dt><dd>No. È il valore medio dichiarato in dogana da chi importa in Italia, su tutte le pezzature. Serve per confrontare il proprio prezzo d&#x27;acquisto con la media e per leggere l&#x27;andamento, non come quotazione.</dd><dt>Quanto è aggiornato?</dt><dd>Il dato esce ogni settimana e copre fino a circa due settimane prima: la settimana più recente è sempre incompleta alla fonte e viene pubblicata solo quando è chiusa.</dd></dl>\n</section>"}