nnellate":1164.435,"valore_unitario":7.676},{"periodo":"2026-M07","tonnellate":960.3879999999999,"valore_unitario":7.376},{"periodo":"2026-M08","tonnellate":993.4719999999999,"valore_unitario":7.69}]},"provenienze_settimanali":{"dalla":"2026-W42","alla":"2026-W45","settimane":4,"voci":[{"codice":"WORLD","paese":"tutte le provenienze","tonnellate":1119.0,"quota":100.0,"prezzo":7.05,"variazione":-1.9,"settimane_con_dati":4,"totale":true},{"codice":"SN","paese":"Senegal","tonnellate":149.0,"quota":13.0,"prezzo":7.81,"variazione":0.6,"settimane_con_dati":4,"totale":false},{"codice":"MA","paese":"Marocco","tonnellate":629.0,"quota":56.0,"prezzo":6.71,"variazione":-7.0,"settimane_con_dati":4,"totale":false},{"codice":"TN","paese":"Tunisia","tonnellate":173.0,"quota":15.0,"prezzo":8.54,"variazione":-1.8,"settimane_con_dati":4,"totale":false}]},"revisioni_recenti":[],"bollettino":[{"titolo":"Volumi fuori dall'intervallo abituale","testo":"Le quantità della settimana (362 tonnellate) sono sopra quasi tutti i valori delle stesse settimane degli ultimi anni (intervallo abituale da 141 a 392 tonnellate). Sui volumi lo scarto anticipa spesso il prezzo delle settimane seguenti.","rilievo":"normale"}],"annotazioni":[],"rese":[{"etichetta":"Congelata intera, al netto della glassatura","resa":100},{"etichetta":"Pulita","resa":55}],"dimostrativo":false,"lede":"La seppia importata in Italia chiude la settimana 45 a 7,05 €/kg di media sulle ultime 4 settimane, in leggero calo dello 0,7% sulla settimana e dell'1,9% sul mese. Sul 2025 il confronto resta in negativo: −8,6%. Per inizio novembre è un livello nella norma. I volumi, 362 tonnellate, sono tra i più alti del periodo. Negli ultimi dodici mesi l'Italia ne ha importato 12.298 tonnellate, per il 22% dal Senegal.","sintesi_html":"<section class=\"pir-riquadro pir-sintesi\" id=\"sintesi\">\n  <h2>Seppia <b>in sintesi</b></h2>\n  <p class=\"pir-lede\">La seppia importata in Italia chiude la settimana 45 a 7,05 €/kg di media sulle ultime 4 settimane, in leggero calo dello 0,7% sulla settimana e dell&#x27;1,9% sul mese. Sul 2025 il confronto resta in negativo: −8,6%. Per inizio novembre è un livello nella norma. I volumi, 362 tonnellate, sono tra i più alti del periodo. Negli ultimi dodici mesi l&#x27;Italia ne ha importato 12.298 tonnellate, per il 22% dal Senegal.</p>\n  <table class=\"pir-tabella\">\n    <caption>Ultime dodici settimane. EUMOFA (Commissione europea), importazioni UE settimanali da dati doganali.</caption>\n    <thead><tr><th>Settimana</th><th>€/kg</th><th>Tonnellate</th></tr></thead>\n    <tbody><tr><td>2026-W34</td><td>7,95</td><td>186</td></tr><tr><td>2026-W35</td><td>7,69</td><td>192</td></tr><tr><td>2026-W36</td><td>7,47</td><td>226</td></tr><tr><td>2026-W37</td><td>7,55</td><td>105</td></tr><tr><td>2026-W38</td><td>7,47</td><td>342</td></tr><tr><td>2026-W39</td><td>7,29</td><td>246</td></tr><tr><td>2026-W40</td><td>7,29</td><td>245</td></tr><tr><td>2026-W41</td><td>7,19</td><td>196</td></tr><tr><td>2026-W42</td><td>6,95</td><td>229</td></tr><tr><td>2026-W43</td><td>7,13</td><td>264</td></tr><tr><td>2026-W44</td><td>7,10</td><td>263</td></tr><tr><td>2026-W45</td><td>7,05</td><td>362</td></tr></tbody>\n  </table>\n  <table class=\"pir-tabella pir-provenienze\"><caption>Provenienze extra-UE a confronto, media delle settimane 42-45 pesata sui volumi. La variazione è sulle quattro settimane precedenti.</caption><thead><tr><th>Provenienza</th><th>€/kg</th><th>Variazione</th><th>Tonnellate</th><th>Quota</th></tr></thead><tbody><tr class=\"pir-totale\"><td>Tutte le provenienze</td><td>7,05</td><td>−1,9%</td><td>1.119</td><td>100%</td></tr><tr><td>Senegal</td><td>7,81</td><td>+0,6%</td><td>149</td><td>13%</td></tr><tr><td>Marocco</td><td>6,71</td><td>−7,0%</td><td>629</td><td>56%</td></tr><tr><td>Tunisia</td><td>8,54</td><td>−1,8%</td><td>173</td><td>15%</td></tr></tbody></table>\n  <dl class=\"pir-domande\"><dt>Perché una media a quattro settimane?</dt><dd>Le provenienze della seppia cambiano peso da una settimana all&#x27;altra, e il prezzo della singola settimana salta con il mix dei carichi. La media delle ultime quattro, pesata sui volumi, si aggiorna comunque ogni settimana e segue l&#x27;andamento vero.</dd><dt>È il prezzo che pago al fornitore?</dt><dd>No. È il valore medio dichiarato in dogana da chi importa in Italia, su tutte le pezzature. Serve per confrontare il proprio prezzo d&#x27;acquisto con la media e per leggere l&#x27;andamento, non come quotazione.</dd><dt>Quanto è aggiornato?</dt><dd>Il dato esce ogni settimana e copre fino a circa due settimane prima: la settimana più recente è sempre incompleta alla fonte e viene pubblicata solo quando è chiusa.</dd></dl>\n</section>"}